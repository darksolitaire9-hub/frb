#!/bin/sh
# Blocks commits containing secrets. Enable once per clone:
#   git config core.hooksPath .githooks
# Requires gitleaks: winget install gitleaks.gitleaks  |  brew install gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed - secret scan SKIPPED (CI will still scan)." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner

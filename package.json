{
  "name": "frb-root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @frb/web dev",
    "dev:worker": "pnpm --filter @frb/worker dev",
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

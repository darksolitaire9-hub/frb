# Normalise line endings: LF in repo and working tree (cross-platform tooling, CI)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: no diff, no EOL conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.heic binary
*.gif  binary
*.ico  binary
*.psd  binary
*.tif  binary
*.tiff binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary

# Lockfiles: treat as generated in diffs
pnpm-lock.yaml   linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
